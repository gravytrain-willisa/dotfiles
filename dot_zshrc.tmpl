# Managed by chezmoi — edit dot_zshrc.tmpl in the dotfiles source repo, not
# this file directly (chezmoi apply will overwrite local edits here).

# ~/.local/bin — chezmoi-managed scripts (connect-to-aws-jump-server.sh,
# etc.) land here, plus npiperelay.exe on WSL. Never on PATH by default in a
# non-login zsh shell (that's a .profile/POSIX-sh convention, and zsh
# doesn't read .profile), so it needs adding explicitly.
export PATH="$HOME/.local/bin:$PATH"

export ZSH="$HOME/.oh-my-zsh"
# Empty, not "robbyrussell"/any theme name — starship (below) owns the
# prompt instead. Leaving an oh-my-zsh theme set here would fight it: both
# set $PROMPT, and whichever loads second silently wins depending on source
# order, rather than either being disabled cleanly.
ZSH_THEME=""
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# Homebrew / Linuxbrew
{{ template "brew-shellenv.sh.tmpl" . }}

# starship prompt — same prompt on both platforms since it's one binary
# (installed via brew-packages.txt) rather than oh-my-zsh's theme system,
# which historically needed platform-specific tweaks (e.g. font/glyph
# fallbacks) to look right on both. No custom starship.toml yet — runs on
# starship's own default config, which is already identical across
# platforms; only worth chezmoi-managing once there's an actual
# customization to pin down. Must load after oh-my-zsh above: oh-my-zsh.sh
# unconditionally sets $PROMPT itself, so initializing starship first would
# just get overwritten.
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# M2_HOME — some tools/IDEs (e.g. IntelliJ) still look for this rather than
# just resolving `mvn` off PATH. SDKMAN's "current" symlink always points at
# whichever Maven version is active (default, or per-project via
# .sdkmanrc/`sdk env`), so this stays correct without hardcoding a version.
export M2_HOME="$SDKMAN_DIR/candidates/maven/current"

# nvm
export NVM_DIR="$HOME/.nvm"
# Checking the file directly rather than `brew list nvm` — the latter spins
# up a whole Ruby process (~200-500ms) on every single shell startup just to
# answer a question a plain path check answers for free.
if command -v brew >/dev/null 2>&1 && [ -s "$(brew --prefix nvm 2>/dev/null)/nvm.sh" ]; then
  NVM_SH="$(brew --prefix nvm)/nvm.sh"
  NVM_COMPLETION="$(brew --prefix nvm)/etc/bash_completion.d/nvm"
else
  NVM_SH="$NVM_DIR/nvm.sh"
  NVM_COMPLETION="$NVM_DIR/bash_completion"
fi
[ -s "$NVM_SH" ] && \. "$NVM_SH"
[ -s "$NVM_COMPLETION" ] && \. "$NVM_COMPLETION"

# pyenv
# PYENV_ROOT stays at ~/.pyenv unconditionally — `brew --prefix pyenv` is the
# Cellar/opt path for the pyenv *binary*, not a pyenv root; pointing
# PYENV_ROOT there would make pyenv install interpreters into a directory
# Homebrew rewrites on upgrade. Only the binary itself needs to be found via
# brew when installed that way, hence PATH (not PYENV_ROOT) below.
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix pyenv 2>/dev/null)/bin/pyenv" ]; then
  export PATH="$(brew --prefix pyenv)/bin:$PATH"
fi
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

# direnv — per-project .envrc auto-loading (installed via brew-packages.txt)
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# fzf — keybindings (Ctrl-R/Ctrl-T) and completion. Homebrew's fzf ships
# these as shell scripts alongside the binary rather than wiring them up
# itself, since not every shell/config wants them.
if command -v brew >/dev/null 2>&1; then
  FZF_PREFIX="$(brew --prefix fzf 2>/dev/null)"
  [ -s "$FZF_PREFIX/shell/completion.zsh" ] && \. "$FZF_PREFIX/shell/completion.zsh"
  [ -s "$FZF_PREFIX/shell/key-bindings.zsh" ] && \. "$FZF_PREFIX/shell/key-bindings.zsh"
fi

# 1Password SSH agent — shared with the run_* scripts that need SSH before
# any interactive shell has run, see .chezmoitemplates/ssh-agent-sock.sh.tmpl.
{{ template "ssh-agent-sock.sh.tmpl" . }}

# AWS region fallback — dot_aws/config.tmpl only sets this for the [default]
# profile; named profiles (aws-vault or otherwise) don't inherit region from
# it. AWS_REGION/AWS_DEFAULT_REGION are the SDK's actual "if this profile
# doesn't specify a region, use this" fallback regardless of profile name —
# this is what fixes STS/GetSessionToken "Missing Region" errors on
# profiles that don't set their own region in ~/.aws/config.
#
# This export only covers tools run *from inside WSL* (e.g. Linuxbrew's
# `aws`). WSL does NOT forward exported shell variables to invoked Windows
# processes by default — that requires explicitly listing the variable in
# WSLENV with the /u flag, which isn't set up here. So this does nothing for
# aws-vault.exe below: that's covered separately by a persistent Windows
# user env var (see README, "AWS default region" / "aws-vault, backed by
# 1Password") set once via PowerShell, which works regardless of whether
# aws-vault.exe is invoked through WSL interop or a native Windows shell.
export AWS_REGION="{{ .aws.default_region }}"
export AWS_DEFAULT_REGION="{{ .aws.default_region }}"

# aws-vault, backed by 1Password (op-desktop backend) rather than a plain
# encrypted file — see run_once_0015-install-aws-vault.sh.tmpl for why WSL and
# macOS install genuinely different binaries for this one.
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
# NOTE: exporting AWS_VAULT_BACKEND here does NOT reach aws-vault.exe — same
# WSL-doesn't-forward-env-vars-to-Windows-processes issue as AWS_REGION
# above. This line only affects tools invoked from inside WSL itself (none,
# currently, since aws-vault only runs as the Windows binary on this
# platform) and is kept for clarity/documentation, not because it does
# anything useful here. The actual backend selection comes from a
# persistent Windows user env var — see README.
export AWS_VAULT_BACKEND=op-desktop
# aws-vault runs as a real Windows binary here (installed via winget), not
# the Linuxbrew formula: only a genuine Windows process passes 1Password
# desktop app's Authenticode check. This makes `aws-vault` on the command
# line transparently invoke it through WSL interop.
if command -v aws-vault.exe >/dev/null 2>&1; then
  aws-vault() { aws-vault.exe "$@"; }
fi
# Same Authenticode-signature story as aws-vault above: a native `op` CLI
# reached through the socat/npiperelay SSH relay would be rejected by the
# desktop app's integration check, so this wraps the winget-installed
# op.exe (already present for the AWS_VAULT_OP_VAULT_ID lookup in README)
# instead of installing a separate Linux op binary.
if command -v op.exe >/dev/null 2>&1; then
  op() { op.exe "$@"; }
fi
{{- else if eq .chezmoi.os "darwin" }}
export AWS_VAULT_BACKEND=op-desktop
# op-desktop also hard-requires a vault + account id (fails with
# `environment variable unset or empty: "OP_VAULT_ID"` otherwise) — unlike
# WSL these are real shell exports here since aws-vault runs as a normal
# native process, not a Windows binary WSL can't forward env vars to. Set
# 1password.op_vault_id/op_account_id in .chezmoidata/dotfiles.yaml (see
# README, "aws-vault env vars") to populate them.
{{- if (index . "1password").op_vault_id }}
export AWS_VAULT_OP_VAULT_ID="{{ (index . "1password").op_vault_id }}"
{{- end }}
{{- if (index . "1password").op_account_id }}
export AWS_VAULT_OP_DESKTOP_ACCOUNT_ID="{{ (index . "1password").op_account_id }}"
{{- end }}
{{- end }}

# op-login — exports whatever env vars are listed in op-env-vars.txt into
# this shell, each pulled from the mapped 1Password credential. Generic by
# design: adding a new tool's API key later is a one-line manifest edit, not
# a new shell function. Tries one `op inject` covering every mapped var
# first, so the common case (everything resolves fine) costs a single
# op(.exe) process/unlock prompt rather than one per var (see aws-login
# below for why that matters — each op(.exe) invocation is a fresh process
# that can re-trigger 1Password's unlock). But a batched `op inject` fails
# outright if even one referenced item/field has been renamed or deleted —
# so on failure this falls back to resolving each line individually via
# `op read`, exporting whatever does resolve and warning about whatever
# doesn't, rather than one bad manifest line blocking every credential.
op-login() {
  local manifest="$HOME/.config/dotfiles/op-env-vars.txt"
  if [ ! -f "$manifest" ]; then
    echo "op-login: $manifest not found" >&2
    return 1
  fi
  local template="" var ref count=0
  while read -r var ref; do
    case "$var" in ''|'#'*) continue ;; esac
    template="${template}${var}=${ref}
"
    count=$((count + 1))
  done <"$manifest"

  if [ "$count" -eq 0 ]; then
    echo "op-login: no entries in $manifest" >&2
    return 1
  fi

  local resolved
  if resolved="$(printf '%s' "$template" | op inject 2>/dev/null)"; then
    while IFS='=' read -r key val; do
      [ -n "$key" ] && export "$key=$val"
    done <<<"$resolved"
    echo "Exported $count env var(s) from 1Password ($manifest)." >&2
    return 0
  fi

  echo "op-login: batched op inject failed — falling back to one op read per entry (one prompt each)" >&2
  local val exported=0 failed=0
  while read -r var ref; do
    case "$var" in ''|'#'*) continue ;; esac
    if val="$(op read "$ref" 2>/dev/null)"; then
      export "$var=$val"
      exported=$((exported + 1))
    else
      echo "op-login: failed to read '$ref' for \$$var — skipping" >&2
      failed=$((failed + 1))
    fi
  done <"$manifest"
  echo "Exported $exported env var(s), $failed failed (from $manifest)." >&2
  [ "$failed" -eq 0 ]
}

# aws-login <profile> — 1Password's desktop-app integration re-authorizes
# on every separate aws-vault.exe process (it's a one-shot CLI, not a
# long-running client that can hold a cached grant), so calling `aws-vault
# exec <profile> -- aws ...` once per command means one prompt per command.
# This authorizes ONCE via `aws-vault export`, then exports the resulting
# temporary credentials directly into *this* shell, so every subsequent
# `aws ...` call in the same terminal reuses them with no further aws-vault
# or 1Password involvement until they expire. Works identically on macOS
# (plain `aws-vault` binary) and WSL (the aws-vault.exe wrapper function
# above) since it just calls whatever `aws-vault` resolves to.
aws-login() {
  if [ -z "$1" ]; then
    echo "usage: aws-login <profile>" >&2
    return 1
  fi
  local output
  output="$(aws-vault export "$1" --format=export-env --duration=12h)" || return 1
  eval "$output"
  # aws-vault has no concept of storing an account ID alongside credentials
  # (its keyring entry is just access key/secret/session token) — derive it
  # instead of duplicating it somewhere that could drift from the real
  # account the credentials belong to. Runs against the credentials just
  # exported above, via WSL/macOS's own `aws` (Linuxbrew/brew), not
  # aws-vault.exe — plain env var auth needs no 1Password involvement.
  export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"
  echo "AWS credentials for '$1' exported into this shell (valid 12h)." >&2
  echo "AWS_ACCOUNT_ID=$AWS_ACCOUNT_ID" >&2

  # Piggyback CodeArtifact/ECR auth on the same login instead of leaving them
  # as separate manual steps — both need AWS_ACCOUNT_ID, which only exists
  # once this function has run, so there's no useful world where you'd call
  # them without having just called aws-login.
  codeartifact_auth "$1"
  ecr_auth
}

# Login reminders ------------------------------------------------------------
#
# op-login/aws-login stay manual (not auto-run at shell startup) since both
# can trigger a 1Password unlock prompt, and aws-login additionally cascades
# into codeartifact_auth/ecr_auth (a docker login, npm config writes) — too
# disruptive to fire on every new terminal, and aws-login has no sane default
# `<profile>` to auto-run with anyway. This is the lighter-weight
# alternative: a plain MOTD-style check that only reads state already in the
# environment/on disk (no 1Password or AWS calls of its own), so forgetting
# to log in surfaces immediately as a reminder instead of failing later
# mid-command.
dotfiles-login-reminder() {
  local manifest="$HOME/.config/dotfiles/op-env-vars.txt"
  if [ -f "$manifest" ]; then
    local var ref val missing=0
    while read -r var ref; do
      case "$var" in ''|'#'*) continue ;; esac
      eval "val=\$$var"
      if [ -z "$val" ]; then
        missing=1
        break
      fi
    done <"$manifest"
    [ "$missing" -eq 1 ] && echo "Reminder: run 'op-login' to export 1Password-backed API keys into this shell." >&2
  fi

  if [ -z "$AWS_ACCOUNT_ID" ]; then
    echo "Reminder: run 'aws-login <profile>' to export AWS credentials (also refreshes CodeArtifact/ECR auth) into this shell." >&2
  fi

  echo "Run 'help' to see all dotfiles-provided commands." >&2
}
dotfiles-login-reminder

# mtime <path> — seconds-since-epoch of a file's mtime. `stat`'s flags for
# this differ between GNU coreutils (Linux) and BSD (macOS) — trying both
# rather than templating on .chezmoi.os keeps this a plain portable
# function instead of yet another os-conditional block.
mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}


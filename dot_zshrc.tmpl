# AWS CodeArtifact authentication ------------------------------------------
#
# CodeArtifact tokens last 12h; cache to a file (mtime as the timestamp) so
# repeat shells/logins within that window skip the API call entirely. Cache
# file and exported env var are keyed per aws-vault profile + domain (see
# `.codeartifact` in `.chezmoidata/dotfiles.yaml`) since a profile can list
# more than one domain (e.g. two separate CodeArtifact domains under the
# same `gravytrain` account), each of which needs its own independent
# token live at once.
CODEARTIFACT_TOKEN_TTL=43200 # 12h, matches --duration-seconds below

codeartifact_auth() {
  local aws_profile="$1"
  if [ -z "$AWS_ACCOUNT_ID" ]; then
    echo "codeartifact_auth: AWS_ACCOUNT_ID not set — run 'aws-login <profile>' first" >&2
    return 1
  fi

  # Each entry is "domain:repository:token_env:scope1,scope2,..." (scopes
  # empty when the domain isn't npm-backed) on its own line. Domain/
  # repository/scope names can't contain ':', ',' or whitespace
  # (CodeArtifact/npm naming rules), so this plain-text encoding is safe to
  # split on without a real serialization format. Newline-delimited, not
  # space-delimited: `for x in $unquoted_var` only word-splits under bash,
  # not zsh (zsh needs SH_WORD_SPLIT, which oh-my-zsh doesn't set) — this
  # file only ever runs under zsh, so a space-separated list would silently
  # process just the first entry and never error. `while read` splits on
  # explicit delimiters regardless of shell/options, so it's used for both
  # the entry list and (via plain parameter expansion, below) the
  # comma-separated scope list within each entry.
  local entries=""
  case "$aws_profile" in
  {{- range $profile, $domains := .codeartifact }}
  {{ $profile }})
    entries="{{ range $domains }}{{ .domain }}:{{ .repository }}:{{ if hasKey . "env" }}{{ .env }}{{ else }}CODEARTIFACT_AUTH_TOKEN{{ end }}:{{ if hasKey . "npm_scopes" }}{{ range $i, $s := .npm_scopes }}{{ if $i }},{{ end }}{{ $s }}{{ end }}{{ end }}
{{ end }}"
    ;;
  {{- end }}
  *)
    echo "codeartifact_auth: no CodeArtifact config for profile '$aws_profile' — skipping" >&2
    return 0
    ;;
  esac

  local domain repository token_env scopes_csv
  while IFS=':' read -r domain repository token_env scopes_csv; do
    [ -z "$domain" ] && continue

    local token_cache="$HOME/.cache/codeartifact-token-${aws_profile}-${domain}"
    local threshold=$((CODEARTIFACT_TOKEN_TTL - 3600)) # refresh with <1h left
    local token=""
    if [ -f "$token_cache" ]; then
      local age=$(( $(date +%s) - $(mtime "$token_cache") ))
      [ "$age" -lt "$threshold" ] && token="$(cat "$token_cache")"
    fi

    if [ -z "$token" ]; then
      echo "Refreshing CodeArtifact token for '$aws_profile'/'$domain'..." >&2
      token="$(aws codeartifact get-authorization-token \
        --domain "$domain" \
        --domain-owner "$AWS_ACCOUNT_ID" \
        --region "$AWS_REGION" \
        --duration-seconds "$CODEARTIFACT_TOKEN_TTL" \
        --query authorizationToken --output text)" || return 1

      mkdir -p "$(dirname "$token_cache")"
      echo "$token" >"$token_cache"
      chmod 600 "$token_cache"
    fi

    export "${token_env}=${token}"

    if [ -n "$scopes_csv" ]; then
      # Unlike `aws codeartifact login --tool npm`, which writes the literal
      # token into ~/.npmrc as plaintext (fine for its 12h life, but it
      # means the secret sits on disk and the file changes on every
      # refresh), this writes a `${<token_env>}` placeholder instead — npm
      # expands `${VAR}` references in .npmrc values against the
      # environment at request time, so the actual token only ever lives in
      # the env var/cache file above, never in .npmrc itself.
      local registry_host="${domain}-${AWS_ACCOUNT_ID}.d.codeartifact.${AWS_REGION}.amazonaws.com"
      npm config set "//${registry_host}/npm/${repository}/:_authToken" "\${${token_env}}"
      # One repository can be the upstream for multiple npm scopes, so the
      # registry mapping is per-scope even though the authToken line above
      # is only needed once per repository. Plain parameter-expansion
      # splitting, not `for scope in $scopes_csv` after `IFS=','` — same
      # zsh word-splitting hazard as the entries list above (unquoted `for`
      # doesn't honour IFS under zsh), so this walks the comma list by hand
      # instead. `scope=""` (not a bare `local scope`) in the same
      # statement as `remaining_scopes` — on the second+ npm-backed domain
      # in one call, `scope` is already local with a leftover value from
      # the previous domain's loop, and a *bare* re-declaration of an
      # already-local, already-valued name is a real zsh quirk: `local
      # name` with no assignment prints "name=value" to stdout when name is
      # already local. Assigning (even to "") suppresses that.
      local scope="" remaining_scopes="$scopes_csv"
      while [ -n "$remaining_scopes" ]; do
        scope="${remaining_scopes%%,*}"
        case "$remaining_scopes" in
        *,*) remaining_scopes="${remaining_scopes#*,}" ;;
        *) remaining_scopes="" ;;
        esac
        npm config set "@${scope}:registry" "https://${registry_host}/npm/${repository}/"
      done
    fi
  done <<<"$entries"
}

# AWS ECR authentication ----------------------------------------------------
#
# `docker login` credentials also last 12h; cache freshness in our own stamp
# file rather than ~/.docker/config.json's mtime — that file is touched by
# any unrelated `docker login` (another registry, Docker Desktop itself),
# which would reset the clock and mask an actually-expired ECR token.
ECR_AUTH_MAX_AGE=39600 # 11h — refresh with <1h left
ECR_AUTH_STAMP="$HOME/.cache/ecr-auth-stamp"

ecr_auth() {
  if [ -z "$AWS_ACCOUNT_ID" ]; then
    echo "ecr_auth: AWS_ACCOUNT_ID not set — run 'aws-login <profile>' first" >&2
    return 1
  fi

  local registry="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
  local config="$HOME/.docker/config.json"

  if [ -f "$config" ] && [ -f "$ECR_AUTH_STAMP" ]; then
    local age=$(( $(date +%s) - $(mtime "$ECR_AUTH_STAMP") ))
    local has_entry
    has_entry="$(jq -r --arg reg "$registry" '.auths | keys[] | select(. == $reg)' "$config" 2>/dev/null)"
    if [ -n "$has_entry" ] && [ "$age" -lt "$ECR_AUTH_MAX_AGE" ]; then
      return 0
    fi
  fi

  echo "Logging in to ECR..." >&2
  aws ecr get-login-password --region "$AWS_REGION" \
    | docker login --username AWS --password-stdin "$registry"
  mkdir -p "$(dirname "$ECR_AUTH_STAMP")"
  touch "$ECR_AUTH_STAMP"
}

# Automated updates ---------------------------------------------------------
#
# Everything this machine's setup depends on, in one command: the dotfiles
# repo itself, Homebrew/Linuxbrew formulas, apt packages (Linux only — no
# apt on macOS), and SDKMAN candidates. Deliberately interactive/on-demand
# rather than a background cron/launchd job — several of these can prompt
# (sudo password, SDKMAN's per-candidate upgrade confirmations), so running
# it unattended would either hang or silently fail.
update-all() {
  echo "==> chezmoi update" >&2
  chezmoi update

  echo "==> brew update && brew upgrade -y" >&2
  brew update && brew upgrade -y

  echo "==> brew cleanup" >&2
  brew cleanup

{{- if eq .chezmoi.os "linux" }}
  echo "==> apt update && apt upgrade" >&2
  sudo apt update && sudo apt upgrade -y

  echo "==> apt autoremove && apt clean" >&2
  sudo apt autoremove -y && sudo apt clean
{{- end }}

  # npm globals, per nvm version — each Node version has its own global
  # node_modules, so this has to loop the same way node-globals.txt's own
  # install script does. `ncu -g` itself never touches installed packages —
  # even with `-u` it only rewrites a package.json, which global mode
  # doesn't have — so the minor/patch set has to be applied by hand via
  # `npm install -g`, built from `--jsonUpgraded`'s package:version map.
  # `--target minor` is npm-check-updates' own semver-major detection (not
  # this repo's node-globals.txt constraint syntax); the plain `ncu -g`
  # afterwards only has major bumps left to report, since minor/patch were
  # just applied above it — printed for a human to apply by hand rather
  # than auto-applied, since a major bump can break the CLI's own behavior.
  # Skips any Node version that doesn't have npm-check-updates installed
  # (only installed on Node >=22 per node-globals.txt) rather than erroring.
  echo "==> npm globals (npm-check-updates)" >&2
  while read -r version flag; do
    [ -z "$version" ] && continue
    case "$version" in '#'*) continue ;; esac
    nvm use "$version" >/dev/null
    if ! command -v ncu >/dev/null 2>&1; then
      echo "-- node $version: npm-check-updates not installed, skipping --" >&2
      continue
    fi

    minor_json="$(ncu -g --jsonUpgraded --target minor)"
    if [ "$minor_json" = "{}" ]; then
      echo "-- node $version: minor/patch already up to date --" >&2
    elif ! command -v jq >/dev/null 2>&1; then
      echo "-- node $version: jq not installed, skipping minor/patch apply --" >&2
    else
      minor_specs=()
      minor_names=()
      while IFS=$'\t' read -r pkg ver; do
        minor_specs+=("${pkg}@${ver}")
        minor_names+=("$pkg")
      done < <(echo "$minor_json" | jq -r 'to_entries[] | "\(.key)\t\(.value)"')
      # `npm install -g` with no package args (e.g. if the jq parse above
      # somehow yields nothing) doesn't no-op — it self-upgrades npm to
      # latest, which can be a major bump. Never call it without a
      # confirmed non-empty spec list.
      if [ "${#minor_specs[@]}" -eq 0 ]; then
        echo "-- node $version: failed to parse minor/patch updates, skipping apply --" >&2
      else
        echo "-- node $version: applying minor/patch updates --" >&2
        allow_scripts="$(IFS=,; echo "${minor_names[*]}")"
        npm install -g --allow-scripts="$allow_scripts" "${minor_specs[@]}"
      fi
    fi

    echo "-- node $version: major updates available (apply manually) --" >&2
    ncu -g
  done < "$HOME/.config/dotfiles/nvm-versions.txt"
  nvm use default >/dev/null

  # No `sdk upgrade` here deliberately — unlike brew/apt, SDKMAN candidate
  # versions are pinned in sdkman-packages.txt (same `default`-marker
  # convention as nvm-versions.txt/pyenv-versions.txt), not left to
  # "whatever's newest". `sdk upgrade` doesn't just bump patch versions, it
  # can also prompt to switch your local default to upstream's current
  # recommendation — with sdkman_auto_answer=true (needed so this function
  # doesn't block on stdin) that prompt auto-accepts, which silently pulled
  # in a completely different JDK vendor/version than the one pinned here.
  # Bump the version in sdkman-packages.txt instead, same as any other
  # manifest in this repo.
  echo "==> sdk selfupdate && sdk update" >&2
  sdk selfupdate && sdk update

  # `chezmoi update` above can change dot_zshrc.tmpl itself (new functions/
  # aliases/exports) — this shell's already-running zsh process keeps
  # whatever it loaded at startup, so without this you'd have update-all's
  # own effects require a manual `exec zsh` anyway, same as after any other
  # `chezmoi apply`.
  exec zsh
}

# Aliases --------------------------------------------------------------

# Docker
# The --format braces below are literal Docker template syntax, not
# chezmoi/Go template syntax — this file is itself a .tmpl, so they have to
# be escaped as string literals or chezmoi tries to evaluate them as its own
# template actions (and fails: "map has no entry for key Repository").
alias docker-update-images='docker images --format {{ "\"{{.Repository}}:{{.Tag}}\"" }} | xargs -L1 docker pull'
alias docker-prune-all='docker system prune --volumes -f'

# Gradle
gradle-refresh-dependencies() {
  # `-x checkstyleMain`/`-x spotbugsTest`/etc. only make sense if the
  # project actually applies those plugins — excluding a task that doesn't
  # exist fails the whole build ("Task 'x' not found in project"), which is
  # exactly what happens if this runs against a project with no checkstyle/
  # spotbugs setup. So rather than hardcoding a fixed task list, ask Gradle
  # what tasks actually exist first and only exclude the ones that do,
  # covering any (checkstyle|spotbugs)* task across every source set
  # (Main/Test/IntegrationTest/...), not just the two most common ones.
  local exclude_flags=()
  local task
  while IFS= read -r task; do
    [ -n "$task" ] && exclude_flags+=(-x "$task")
  done < <(./gradlew tasks --all --console=plain -q 2>/dev/null \
    | grep -oE '^(checkstyle|spotbugs)[A-Za-z0-9]*' | sort -u)
  ./gradlew --refresh-dependencies clean build -x test "${exclude_flags[@]}"
}
alias gradle-show-dependency-updates='./gradlew --refresh-dependencies dependencyUpdates'

# npm
alias npm-recreate-package-lock='echo "{}" > package-lock.json && rm -rf node_modules/ && npm i'

# Navigation
alias cd-projects='cd $HOME/projects'

# Git maintenance across every repo under ~/projects (where git-repos.txt's
# clones land, one directory per repo, no nesting) — `*(N/)` is zsh's inline
# null_glob + "directories only" qualifier, so an empty/missing ~/projects
# doesn't error the loop out. Runs in a subshell per repo (`(cd ... && ...)`)
# so a failure in one repo can't leave the calling shell's cwd changed, and
# doesn't abort the loop — best-effort across every repo, not all-or-nothing.
_git_all_projects() {
  local dir
  for dir in $HOME/projects/*(N/); do
    [ -e "$dir/.git" ] || continue
    echo "==> ${dir%/}" >&2
    (cd "$dir" && "$@")
  done
}
git-fetch-all() { _git_all_projects git fetch --all --tags --force --prune --prune-tags; }
git-cleanup-all() { _git_all_projects git gc --aggressive; }

# Jump servers — functions, not aliases, since aliases can't take arguments
# (the alias text is substituted as-is; `$1`/`$2` in an alias body would
# refer to the *invoking shell's* positional params, not ones passed to the
# alias itself).
kgm-connect-to-jump-server() { connect-to-aws-jump-server.sh kgm "$1" "$2"; }
triton-connect-to-jump-server() { connect-to-aws-jump-server.sh triton "$1" "$2"; }

# Connect to other servers — hostnames come from `servers` in
# .chezmoidata/dotfiles.yaml, not hardcoded here (see CLAUDE.md: never
# hardcode a value that already exists in that YAML). Same identity from the
# 1Password SSH agent as everywhere else in this file — no `-i` needed.
{{- range $name, $host := .servers }}
alias {{ $name }}='ssh ubuntu@{{ $host }}'
{{- end }}

# help — lists every dotfiles-provided function/alias in one place, since
# they've accumulated across this file with no other single index. Static
# list below must be kept in sync by hand when one of these is added/
# removed/renamed (see CLAUDE.md); the server list is generated from the
# same `.servers` data as the aliases above it, so that part never drifts.
help() {
  cat <<'EOF'
Dotfiles-provided commands

Help:
  help                              Show this list.

Credential/ secret management:
  aws-login <profile>               Export AWS credentials for <profile> (12h); also refreshes CodeArtifact + ECR auth.
  op-login                          Export 1Password-backed env vars (op-env-vars.txt) into this shell.

Updates/maintenance:
  update-all                        Update chezmoi, Homebrew/Linuxbrew, apt (Linux/ WSL only), SDKMAN, and npm globals.
  docker-update-images              Re-pull the current tag of every locally present Docker image.
  docker-prune-all                  Prune all docker data except for images (alias for `docker system prune --volumes -f`).

Gradle:
  gradle-refresh-dependencies       Refreshes dependencies with a clean build. Excludes tests & checkstyle/spotbugs tasks if present.
  gradle-show-dependency-updates    Shows all available dependency updates.

npm:
  npm-recreate-package-lock         Recreate package-lock.json and node_modules from scratch.

Navigation:
  cd-projects                       cd to ~/projects.

Git maintenance (every repo under ~/projects):
  git-fetch-all                     git fetch --all --tags --force --prune --prune-tags, in every repo.
  git-cleanup-all                   git gc --aggressive, in every repo.

AWS RDS access via jump servers (requires `aws-login <profile>` to be run first):
  kgm-connect-to-jump-server        SSH tunnel to the KGM AWS jump box <stage> <jump-box-ip>.
  triton-connect-to-jump-server     SSH tunnel to the Triton AWS jump box <stage> <jump-box-ip>.

Direct server connections (ssh ubuntu@<host>, via the 1Password SSH agent):
EOF
{{- range $name, $host := .servers }}
  echo "  {{ $name }}"
{{- end }}
}

# Only define `ll` if nothing earlier in startup (oh-my-zsh, a plugin, the
# system shell) already provides it — `whence` checks aliases/functions/
# builtins/commands alike, not just $PATH.
whence ll >/dev/null || alias ll='ls -lah'

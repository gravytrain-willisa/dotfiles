#!/bin/bash
# Managed by chezmoi — edit dot_local/bin/executable_git-ssh-sign-with-agent.tmpl
# in the dotfiles source repo, not this file directly.
#
# git's gpg.ssh.program (set in dot_gitconfig.tmpl) points at this wrapper
# instead of ssh-keygen directly. Why: commit signing (gpg.format = ssh,
# commit.gpgsign = true) runs `ssh-keygen -Y sign`, a separate code path from
# core.sshCommand — it reads SSH_AUTH_SOCK straight from the process
# environment rather than going through any git-configurable ssh wrapper. An
# IDE's own git integration (IntelliJ, VS Code) on WSL invokes git by calling
# wsl.exe directly, e.g. `wsl.exe -d Ubuntu-26.04 -e git commit ...`, which
# skips login shells/PAM entirely — so SSH_AUTH_SOCK is unset there for the
# same reason it was unset for transport before git-ssh-with-agent existed
# (see that file). Without this wrapper, IntelliJ commits fail signing with
# "Couldn't get agent socket? / fatal: failed to write commit object" even
# though fetch/push already work.
#
# Same shared agent selection as git-ssh-with-agent: local ssh-agent when it
# holds a key, otherwise (WSL) Microsoft's signed ssh-keygen.exe, which signs
# through 1Password's agent pipe natively.
{{ template "ssh-agent-sock.sh.tmpl" . }}

{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}

# ssh-keygen.exe is a Windows process, so every WSL path argument (the -f
# key file, the temporary buffer git signs) must be translated to a Windows
# path first. Only absolute paths are rewritten; flags and values like
# "git" (-n) or "sign" (-Y) pass through untouched.
if [ -n "${DOTFILES_WIN_OPENSSH:-}" ]; then
  for arg in "$@"; do
    case "$arg" in
      /*) arg="$(wslpath -w "$arg")" ;;
    esac
    set -- "$@" "$arg"
    shift
  done
  # The loop above rotated the args once around in order, so "$@" is the
  # translated list again.
  exec "$DOTFILES_WIN_OPENSSH/ssh-keygen.exe" "$@"
fi
{{- end }}
exec ssh-keygen "$@"

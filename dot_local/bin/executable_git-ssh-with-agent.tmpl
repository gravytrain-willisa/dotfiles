#!/bin/bash
# Managed by chezmoi — edit dot_local/bin/executable_git-ssh-with-agent.tmpl
# in the dotfiles source repo, not this file directly.
#
# git's core.sshCommand (set in dot_gitconfig.tmpl) points at this wrapper
# instead of ssh directly. Why: SSH_AUTH_SOCK is normally exported by
# dot_zshrc.tmpl (interactive shells) or /etc/environment (everything else,
# via /etc/environment) — but an IDE's
# own git integration (IntelliJ, VS Code) on WSL invokes git by calling
# wsl.exe directly, e.g. `wsl.exe -d Ubuntu-26.04 -e git ...`. That launch
# path execs the target command straight away rather than going through a
# login shell, so it never runs PAM and never reads /etc/environment either
# — confirmed by testing `wsl.exe -e printenv SSH_AUTH_SOCK` from inside WSL,
# which comes back empty even with /etc/environment correctly set. Every
# other fix here still leaves git with no agent, hence "Permission denied
# (publickey)" from the IDE while a terminal in the same WSL instance works
# fine.
#
# The template below is shared with ~/.zshrc's own agent setup. It prefers
# the local ssh-agent `ssh-login` loads keys into; when that holds no key
# (WSL only) it sets DOTFILES_WIN_OPENSSH instead, and this wrapper runs
# Microsoft's signed ssh.exe, which talks to 1Password's agent pipe natively
# (there is no Linux-side relay any more — see the template for why). It
# works without relying on any inherited environment, so it's correct no
# matter how git itself was launched.
{{ template "ssh-agent-sock.sh.tmpl" . }}

{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}

# ssh.exe reads the Windows-side known_hosts/config, so a first connection to
# a host would otherwise block on a host-key prompt; accept-new matches
# private_dot_ssh/config.tmpl. Args pass through unchanged: git only hands
# ssh a host and a remote command, never a WSL file path.
if [ -n "${DOTFILES_WIN_OPENSSH:-}" ]; then
  exec "$DOTFILES_WIN_OPENSSH/ssh.exe" -o StrictHostKeyChecking=accept-new "$@"
fi
{{- end }}
exec ssh "$@"

# Managed by chezmoi — edit dot_config/dotfiles/env.sh.tmpl in the dotfiles
# source repo, not this file directly.
#
# Environment every process needs, interactive or not. Sourced by:
#   ~/.zshenv        every zsh (interactive, scripts, `zsh -c`, agents) —
#                    inside `emulate sh`, so zsh quirks (nomatch, no word
#                    splitting) can't break it
#   ~/.bash_env      non-interactive bash, via BASH_ENV (exported below)
#   ~/.bash_profile  login bash
#   ~/.zprofile      macOS login zsh (path_helper reorders PATH after zshenv)
# ~/.zshrc is only read by *interactive* zsh, so anything an agent/script/cron
# job/IDE task needs — PATH, tool homes, credentials from the login caches —
# must live here, not there. See "Everything must work in interactive AND
# non-interactive shells" in CLAUDE.md.
#
# Rules for this file: POSIX sh (macOS bash 3.2 and zsh-in-sh-mode must both
# run it — no `${(q)x}`, no arrays, no `<<<`), silent (no stdout/stderr), never
# prompts, and fast (it runs for every shell: no `brew --prefix`, no ruby).
# It only ever *reads* the login caches; writing them (op-login/aws-login/
# ssh-login, which can need a 1Password prompt) stays in dot_zshrc.tmpl.

# PATH ---------------------------------------------------------------------

# _dotfiles_path_front <dir> — put <dir> first on PATH (moving it if already
# present, so a login shell's path_helper reshuffle can be undone), if it
# exists.
_dotfiles_path_front() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
  ":$1:"*) return 0 ;; # already first — the common case in nested shells
  esac
  _rest=""
  _old_ifs="$IFS"
  IFS=:
  for _p in $PATH; do
    [ "$_p" = "$1" ] || _rest="${_rest:+$_rest:}$_p"
  done
  IFS="$_old_ifs"
  PATH="$1${_rest:+:$_rest}"
  export PATH
  unset _rest _old_ifs _p
}

# Linuxbrew / Homebrew — just enough to find brew-installed tools. The full
# `brew shellenv` (MANPATH etc.) still runs in dot_zshrc.tmpl; it's a
# subprocess, too slow for every script.
{{- if eq .chezmoi.os "darwin" }}
for _b in /opt/homebrew /usr/local; do
  if [ -x "$_b/bin/brew" ]; then
    export HOMEBREW_PREFIX="$_b" HOMEBREW_CELLAR="$_b/Cellar"
    _dotfiles_path_front "$_b/sbin"
    _dotfiles_path_front "$_b/bin"
    break
  fi
done
unset _b
{{- else }}
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  export HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew HOMEBREW_CELLAR=/home/linuxbrew/.linuxbrew/Cellar
  _dotfiles_path_front "$HOMEBREW_PREFIX/sbin"
  _dotfiles_path_front "$HOMEBREW_PREFIX/bin"
fi
{{- end }}

# SDKMAN — what sdkman-init.sh (interactive, dot_zshrc.tmpl) does to PATH,
# minus the `sdk` function: each installed candidate's `current` on PATH and
# <CANDIDATE>_HOME (JAVA_HOME, ...) exported. `current` always points at the
# default version, so nothing is hardcoded. M2_HOME is for tools/IDEs that
# look for it instead of resolving `mvn` off PATH.
export SDKMAN_DIR="$HOME/.sdkman"
if [ -d "$SDKMAN_DIR/candidates" ]; then
  for _c in "$SDKMAN_DIR"/candidates/*; do
    [ -d "$_c/current/bin" ] || continue
    _dotfiles_path_front "$_c/current/bin"
    _n="$(basename "$_c" | tr '[:lower:]' '[:upper:]')"
    export "${_n}_HOME=$_c/current"
  done
  unset _c _n
fi
export M2_HOME="$SDKMAN_DIR/candidates/maven/current"

# pyenv — shims on PATH is all a non-interactive shell needs (`pyenv init -`
# in dot_zshrc.tmpl adds the `pyenv` shell function on top). PYENV_ROOT stays
# ~/.pyenv regardless of how the pyenv binary itself was installed.
export PYENV_ROOT="$HOME/.pyenv"
[ -n "${HOMEBREW_PREFIX-}" ] && _dotfiles_path_front "$HOMEBREW_PREFIX/opt/pyenv/bin"
_dotfiles_path_front "$PYENV_ROOT/bin"
_dotfiles_path_front "$PYENV_ROOT/shims"

# nvm — `nvm` itself is a shell function (dot_zshrc.tmpl sources nvm.sh), but
# `node`/`npm`/global CLIs only need the default version's bin dir on PATH.
# Resolves ~/.nvm/alias/default (a version like "24" or "v24.22.2") to the
# highest installed match without sourcing nvm.sh.
if [ -f "$HOME/.nvm/alias/default" ]; then
  _spec="$(cat "$HOME/.nvm/alias/default" 2>/dev/null)"
  _spec="${_spec#v}"
  case "$_spec" in
  [0-9]*)
    _node="$(ls "$HOME/.nvm/versions/node" 2>/dev/null | grep -E "^v${_spec}(\\.|\$)" \
      | sort -t. -k1,1 -k2,2n -k3,3n | tail -n 1)"
    [ -n "$_node" ] && _dotfiles_path_front "$HOME/.nvm/versions/node/$_node/bin"
    ;;
  esac
  unset _spec _node
fi

# chezmoi-managed scripts and wrappers (op, aws-vault, connect-to-aws-jump-
# server.sh, git wrappers, npiperelay.exe). Last, so it wins over everything.
_dotfiles_path_front "$HOME/.local/bin"

# bash reads $BASH_ENV for every non-interactive invocation, so any bash
# script/`bash -c` started from here (an agent's Bash tool, say) re-sources
# this file. Interactive bash is unaffected (it reads .bashrc instead).
[ -f "$HOME/.bash_env" ] && export BASH_ENV="$HOME/.bash_env"

# Static tool config ---------------------------------------------------------

# AWS region fallback — dot_aws/config.tmpl only sets this for the [default]
# profile; named profiles don't inherit it. AWS_REGION/AWS_DEFAULT_REGION are
# the SDK's "profile doesn't specify a region" fallback, which fixes
# STS/GetSessionToken "Missing Region" errors. Only reaches tools run *from
# inside WSL*: WSL doesn't forward exported vars to Windows processes
# (aws-vault.exe, op.exe) without WSLENV, so those rely on persistent Windows
# user env vars instead (see README).
export AWS_REGION="{{ .aws.default_region }}"
export AWS_DEFAULT_REGION="{{ .aws.default_region }}"

{{- if (index . "1password").op_account_id }}
# Pin the 1Password CLI to one account (several are signed in): `op` reads
# OP_ACCOUNT as its default --account. Native `op` (macOS) sees this directly;
# on WSL the ~/.local/bin/op wrapper forwards it to op.exe via WSLENV.
export OP_ACCOUNT="{{ (index . "1password").op_account_id }}"
{{- end }}

{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
# Documentation only — aws-vault only runs as aws-vault.exe here (see
# ~/.local/bin/aws-vault), which never sees this; the real backend selection
# is a persistent Windows user env var (README).
export AWS_VAULT_BACKEND=op-desktop
# JRebel agent (run_once_0024, update-jrebel/update-all): lets IDE plugins and
# `-javaagent:` invocations reference the install dir instead of a hardcoded path.
export JREBEL_HOME="$HOME/.local/share/jrebel"
{{- else if eq .chezmoi.os "darwin" }}
export AWS_VAULT_BACKEND=op-desktop
# op-desktop also hard-requires a vault + account id (fails with
# `environment variable unset or empty: "OP_VAULT_ID"` otherwise) — real
# exports here since aws-vault is a native process on macOS. Set
# 1password.op_vault_id/op_account_id in .chezmoidata/dotfiles.yaml.
{{- if (index . "1password").op_vault_id }}
export AWS_VAULT_OP_VAULT_ID="{{ (index . "1password").op_vault_id }}"
{{- end }}
{{- if (index . "1password").op_account_id }}
export AWS_VAULT_OP_DESKTOP_ACCOUNT_ID="{{ (index . "1password").op_account_id }}"
{{- end }}
{{- end }}

# SSH agent -------------------------------------------------------------------
#
# 1Password agent (starting the WSL relay if needed), preferring the local
# agent `ssh-login` loads keys into while it holds one. Shared with the git
# wrappers and run_* scripts. DOTFILES_1P_SSH_AUTH_SOCK is read by
# dot_zshrc.tmpl's _ssh_select_agent prompt hook.
{{ template "ssh-agent-sock.sh.tmpl" . }}

# Login caches (read-only) ------------------------------------------------------
#
# op-login, aws-login and ssh-login each cost a 1Password unlock/approval
# prompt, and 1Password treats every separate op(.exe)/aws-vault(.exe) process
# as a new app. Their results are kept for DOTFILES_CACHE_TTL seconds
# (plaintext, mode 0600, under ~/.cache — the same exposure as the values
# already being in `env`) and loaded here into every shell, interactive or
# not, with no 1Password involvement. Change `credential_cache_hours` in
# .chezmoidata/dotfiles.yaml (then `chezmoi apply`) to adjust; a
# DOTFILES_CACHE_TTL already in the environment wins. Keep it <= 12h, the
# lifetime of the AWS credentials themselves. An expired cache is deleted and
# simply not loaded — a non-interactive shell can't answer 1Password's prompt,
# so a human has to run `login-all`; `dotfiles-env-status` shows what's stale.
: "${DOTFILES_CACHE_TTL:=$(( {{ .credential_cache_hours }} * 3600 ))}"
OP_ENV_CACHE="$HOME/.cache/op-env-cache"
AWS_LOGIN_CACHE="$HOME/.cache/aws-login-cache"
SSH_LOCAL_AGENT_SOCK="$HOME/.ssh/local-agent.sock"
CODEARTIFACT_TOKEN_TTL=43200 # 12h, matches --duration-seconds in codeartifact_auth

# mtime <path> — seconds-since-epoch of a file's mtime. `stat`'s flags differ
# between GNU coreutils (Linux) and BSD (macOS); trying both keeps this
# portable without an os-conditional block.
mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

# _cache_fresh <file> — exists and younger than DOTFILES_CACHE_TTL.
_cache_fresh() {
  [ -f "$1" ] || return 1
  [ $(( $(date +%s) - $(mtime "$1") )) -lt "$DOTFILES_CACHE_TTL" ]
}

# Variables expected from op-login/aws-login start out empty rather than
# unset, so tools that expand them (npm's `${CODEARTIFACT_AUTH_TOKEN}` in
# .npmrc, most notably) don't fail in projects that never needed them. Only
# fills in variables that are *unset* — a real value is never clobbered.
_dotfiles_blank_defaults() {
  _manifest="$HOME/.config/dotfiles/op-env-vars.txt"
  if [ -f "$_manifest" ]; then
    while read -r _var _ref; do
      case "$_var" in ''|'#'*) continue ;; esac
      eval "export $_var=\"\${$_var-}\""
    done <"$_manifest"
  fi
  # CodeArtifact token vars (set by aws-login → codeartifact_auth, see
  # `.codeartifact` in .chezmoidata/dotfiles.yaml).
  while read -r _var; do
    [ -z "$_var" ] && continue
    eval "export $_var=\"\${$_var-}\""
  done <<EOF
{{ range $profile, $domains := .codeartifact }}{{ range $domains }}{{ if hasKey . "env" }}{{ .env }}{{ else }}CODEARTIFACT_AUTH_TOKEN{{ end }}
{{ end }}{{ end }}EOF
  unset _manifest _var _ref
}
_dotfiles_blank_defaults

# op-login's cache is ignored once the manifest is newer than it, so a newly
# added manifest line gets resolved rather than silently missing.
_op_cache_usable() {
  _cache_fresh "$OP_ENV_CACHE" && [ ! "$HOME/.config/dotfiles/op-env-vars.txt" -nt "$OP_ENV_CACHE" ]
}

if _op_cache_usable; then
  . "$OP_ENV_CACHE"
else
  rm -f "$OP_ENV_CACHE"
fi

if _cache_fresh "$AWS_LOGIN_CACHE"; then
  . "$AWS_LOGIN_CACHE"
else
  rm -f "$AWS_LOGIN_CACHE"
fi

# Every still-valid cached CodeArtifact token, straight into its env var (npm's
# `${...}` placeholder in .npmrc), so a new shell has working CodeArtifact auth
# without an aws-login. Same freshness threshold as codeartifact_auth's
# refresh check. Entries are "profile:domain:token_env".
while IFS=':' read -r _profile _domain _token_env; do
  [ -z "$_profile" ] && continue
  _token_cache="$HOME/.cache/codeartifact-token-${_profile}-${_domain}"
  [ -f "$_token_cache" ] || continue
  [ $(( $(date +%s) - $(mtime "$_token_cache") )) -lt $((CODEARTIFACT_TOKEN_TTL - 3600)) ] || continue
  export "${_token_env}=$(cat "$_token_cache")"
done <<EOF
{{ range $profile, $domains := .codeartifact }}{{ range $domains }}{{ $profile }}:{{ .domain }}:{{ if hasKey . "env" }}{{ .env }}{{ else }}CODEARTIFACT_AUTH_TOKEN{{ end }}
{{ end }}{{ end }}EOF
unset _profile _domain _token_env _token_cache

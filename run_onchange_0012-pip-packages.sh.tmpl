#!/bin/bash
# hash: {{ include "dot_config/dotfiles/pip-packages.txt" | sha256sum }}
# Re-runs only when pip-packages.txt's contents change. Installs against
# whichever Python pyenv-versions.txt set as global.
set -euo pipefail

{{ template "brew-shellenv.sh.tmpl" . }}

# PYENV_ROOT stays at ~/.pyenv unconditionally — see dot_zshrc.tmpl for why
# pointing it at `brew --prefix pyenv` (the formula/binary path, not a pyenv
# root) is wrong.
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix pyenv 2>/dev/null)/bin/pyenv" ]; then
  export PATH="$(brew --prefix pyenv)/bin:$PATH"
fi
eval "$(pyenv init -)"

while read -r package; do
  [ -z "$package" ] && continue
  case "$package" in '#'*) continue ;; esac
  pip install "$package" || echo "Failed to install $package — skipping" >&2
done < "$HOME/.config/dotfiles/pip-packages.txt"

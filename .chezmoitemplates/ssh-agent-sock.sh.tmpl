{{/* Reusable snippet: point SSH_AUTH_SOCK at the 1Password SSH agent, on WSL2 falling back to Windows' signed OpenSSH binaries (no relay).

     Included via {{ template "ssh-agent-sock.sh.tmpl" . }} — by dot_zshrc.tmpl
     (so interactive shells get an agent) and by any run_* script that needs
     SSH before an interactive shell has ever existed. That second case is the
     reason this is a shared snippet rather than living in dot_zshrc.tmpl:
     chezmoi runs scripts with bash, non-interactively, so ~/.zshrc is never
     sourced and a script that assumed it had been reaches `git clone` with no
     agent at all. */ -}}
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
# WSL2 can't reach 1Password's Windows named pipe from Linux, and the
# socat/npiperelay bridge that used to cover that is an unsigned binary that
# Smart App Control / Code Integrity (event 3077) refuses to run. So there is
# no relay and no 1Password socket here: the Linux side only ever uses the
# local ssh-agent that `ssh-login` loads keys into. When that agent holds no
# key, DOTFILES_WIN_OPENSSH is set to the directory of Microsoft's own signed
# OpenSSH binaries, and the git wrappers (and run_* scripts) call
# ssh.exe/ssh-add.exe/ssh-keygen.exe from there instead — those talk to
# 1Password's agent pipe natively. Requires 1Password's SSH agent enabled on
# the Windows side (Settings -> Developer -> "Use the SSH Agent") and the
# Windows `ssh-agent` service stopped/disabled so it doesn't own the pipe.
# Not exported on purpose: only this shell/script (or whichever wrapper
# includes this snippet itself) needs it.
DOTFILES_SSH_AGENT_MANAGED=1
DOTFILES_LOCAL_AGENT_SOCK="$HOME/.ssh/local-agent.sock"
if SSH_AUTH_SOCK="$DOTFILES_LOCAL_AGENT_SOCK" ssh-add -l >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$DOTFILES_LOCAL_AGENT_SOCK"
  DOTFILES_WIN_OPENSSH=""
else
  # Don't leave a stale SSH_AUTH_SOCK behind (e.g. the old relay's path from
  # /etc/environment): Linux ssh would only fail against it.
  unset SSH_AUTH_SOCK
  DOTFILES_WIN_OPENSSH="/mnt/c/Windows/System32/OpenSSH"
  [ -x "$DOTFILES_WIN_OPENSSH/ssh.exe" ] || DOTFILES_WIN_OPENSSH=""
fi
{{- else if eq .chezmoi.os "darwin" }}
# 1Password exposes a Unix socket directly on macOS — no relay needed, just
# needs the same "Use the SSH Agent" toggle switched on.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# Prefer the local ssh-agent that `ssh-login` (dot_zshrc.tmpl) loads keys
# into, whenever it's up and actually holds one; otherwise leave the
# 1Password socket in place. The 1Password path is remembered for
# dot_zshrc.tmpl's _ssh_select_agent prompt hook, which flips between the
# two in an already-running shell. POSIX sh only — this also runs in the
# macOS bash 3.2 run_* scripts and the git wrappers.
DOTFILES_SSH_AGENT_MANAGED=1
DOTFILES_1P_SSH_AUTH_SOCK="$SSH_AUTH_SOCK"
if SSH_AUTH_SOCK="$HOME/.ssh/local-agent.sock" ssh-add -l >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$HOME/.ssh/local-agent.sock"
fi
{{- end }}
{{- /* Bare-metal (non-WSL) Linux: no relay applies, so SSH_AUTH_SOCK is
       left untouched — whatever local agent (if any) is already running. */}}

{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) -}}
#!/bin/bash
# Sets up the WSL2 <-> 1Password SSH agent relay — the doc this repo is
# built from calls this "the messiest part" of the whole cross-platform
# setup. 1Password's SSH agent is a Windows process exposing a Windows named
# pipe, and WSL2 can't reach a Windows named pipe directly. socat + npiperelay
# bridge that pipe into a Unix socket inside WSL, which dot_zshrc.tmpl then
# points SSH at via SSH_AUTH_SOCK.
#
# Scoped to genuine WSL2 (kernel release contains "microsoft"), not just any
# Linux — on bare-metal Linux there's no Windows named pipe to relay from, so
# this would just waste effort downloading a Windows .exe for nothing.
#
# This only sets up the plumbing. You still have to, once, by hand:
#   1Password desktop app -> Settings -> Developer -> "Use the SSH Agent"
# That's a GUI toggle with no CLI/file equivalent, so it can't be scripted.
set -euo pipefail

if ! command -v socat >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y socat
fi

NPIPERELAY_BIN="$HOME/.local/bin/npiperelay.exe"
if [ ! -x "$NPIPERELAY_BIN" ]; then
  mkdir -p "$HOME/.local/bin"
  TMP_DIR="$(mktemp -d)"
  curl -fsSL -o "$TMP_DIR/npiperelay.zip" \
    "https://github.com/albertony/npiperelay/releases/latest/download/npiperelay_windows_amd64.zip"
  unzip -o -j "$TMP_DIR/npiperelay.zip" npiperelay.exe -d "$HOME/.local/bin"
  chmod +x "$NPIPERELAY_BIN"
  rm -rf "$TMP_DIR"
fi
{{- end }}
